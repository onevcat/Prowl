{
  "name": "prowl-web-workspace",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun run --filter '*' build",
    "build:binaries": "bun run scripts/build-binaries.ts",
    "check:bundle": "bun run scripts/check-bundle-size.ts",
    "check:deps": "bun run scripts/check-lockfiles.ts && bun run scripts/check-dependency-budget.ts && bun run scripts/check-client-storage.ts && bun run scripts/check-client-runtime.ts",
    "check:locks": "bun run scripts/check-lockfiles.ts",
    "e2e": "bun --bun playwright test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test apps packages scripts",
    "test:web": "bun run --filter @prowl/web test",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "1.59.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
