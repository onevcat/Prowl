            "value" : "工作流文件已被移动或删除。请返回以选择其他工作流。"
          }
        }
      }
    },
    "The workflow run failed but produced no logs." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作流运行失败，但未生成日志。"
          }
        }
      }
    },
    "The worktree was deleted, but %@ could not be deleted safely.\n\n%@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "worktree 已删除，但 %@ 无法安全删除。\n\n%@"
          }
        }
      }
    },
    "This Host no longer recognizes this Mac. Enter a new pairing code from Host." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此主机已不再识别这台 Mac。请输入主机上新的配对码。"
          }
        }
      }
    },
    "This Mac has no network interface with the address %@." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 没有地址为 %@ 的网络接口。"
          }
        }
      }
    },
    "This Mac only (127.0.0.1)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅这台 Mac（127.0.0.1）"
          }
        }
      }
    },
    "This Mac’s address" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 的地址"
          }
        }
      }
    },
    "This Pane" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此窗格"
          }
        }
      }
    },
    "This Worktree" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 worktree"
          }
        }
      }
    },
    "This app bundles no installable skills." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此应用未捆绑任何可安装的技能。"
          }
        }
      }
    },
    "This branch has no committed changes relative to %@ (%@)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相对于 %@（%@），此分支没有已提交的更改"
          }
