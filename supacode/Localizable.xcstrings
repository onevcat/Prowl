          }
        }
      }
    },
    "This file is too large to preview. Open the bundle to inspect it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件过大，无法预览。请打开 Bundle 查看。"
          }
        }
      }
    },
    "This file was removed from the bundle." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件已从 Bundle 中移除。"
          }
        }
      }
    },
    "This folder doesn't support worktrees." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件夹不支持 worktree。"
          }
        }
      }
    },
    "This folder is available in the sidebar. Git-only actions stay hidden." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件夹已显示在边栏中。仅适用于 Git 的操作会保持隐藏。"
          }
        }
      }
    },
    "This pane" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此窗格"
          }
        }
      }
    },
    "This profile gets its own runtime home: separate login and usage, but also separate skills, global instructions, and session history. The first launch signs in through the agent itself." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此配置拥有独立的运行时主目录：登录和用量相互独立，技能、全局指令和会话历史也相互独立。首次启动时需通过 Agent 自身登录。"
          }
        }
      }
    },
    "This profile's runtime cannot take a launch prompt." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此配置的运行时不支持启动提示词。"
          }
        }
      }
    },
    "This removes %@ from Prowl." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
