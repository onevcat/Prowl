          }
        }
      }
    },
    "The run continues; %@ proceeds without this delivery." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运行会继续；%@ 将在没有这份交付的情况下进行。"
          }
        }
      }
    },
    "The saved JSON result file; output contains its fields" : {
