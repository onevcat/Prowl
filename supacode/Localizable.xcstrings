          }
        }
      }
    },
    "The pane this workflow runs from — the CLI's [source] argument.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行此工作流的面板——CLI 的 [source] 参数。"
          }
        }
      }
    },
    "The prowl command is now available at %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "prowl 命令现已可用于 %@。"
          }
        }
      }
    },
    "The prowl command line tool has been removed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "prowl 命令行工具已移除。"
          }
        }
      }
    },
    "The selected worktree is no longer available.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选工作树已不可用。"
          }
        }
      }
    },
    "The workflow file was moved or deleted. Go back to choose another workflow.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作流文件已被移动或删除。请返回以选择其他工作流。"
          }
        }
      }
    },
    "The workflow run failed but produced no logs.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作流运行失败，但未生成日志。"
          }
        }
      }
    },
    "The worktree was deleted, but %@ could not be deleted safely.\n\n%@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作树已删除，但 %@ 无法安全删除。\n\n%@"
          }
        }
      }
    },
    "This app bundles no installable skills.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此应用未捆绑任何可安装的技能。"
          }
        }
      }
    },
    "This bundle contains %lld script action(s).\nScripts run with your local user permissions.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此捆绑包包含 %lld 个脚本操作。\n脚本以你的本地用户权限运行。"
          }
        }
      }
    },
    "This removes %@ from Prowl.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将从 Prowl 中移除 %@。"
          }
        }
      }
    },
    "This removes the profile from Prowl. No files will be deleted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将从 Prowl 中移除该配置档案。不会删除任何文件。"
          }
        }
      }
    },
    "This removes the repository from Prowl. Worktrees and the main repository folder stay on disk.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会从 Prowl 移除仓库。工作树和主仓库文件夹仍保留在磁盘上。"
          }
        }
      }
    },
    "This role has no pane": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此角色没有面板"
          }
        }
