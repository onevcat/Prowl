      }
    },
    "This branch has no committed changes relative to its base" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相对于其基准，此分支没有已提交的更改"
          }
        }
      }
    },
    "This branch was not selected." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未选择此分支。"
          }
        }
      }
    },
    "This bundle contains %lld script action(s).\nScripts run with your local user permissions." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
