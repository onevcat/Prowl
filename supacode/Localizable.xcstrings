        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来源 worktree 已不可用。"
          }
        }
      }
    },
    "The starter asks the current agent for today's date in a chosen style." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此起始模板让当前 Agent 以选定的风格报出今天的日期。"
